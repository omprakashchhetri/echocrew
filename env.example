# Copy to .env and edit. .env is git-ignored.
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'

database.default.hostname = localhost
database.default.database = echocrew
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# For a quick local trial without MySQL:
# database.default.database = writable/local.db
# database.default.DBDriver = SQLite3

# Bot protection for public forms. Without these keys a built-in maths challenge is used.
# Free keys: https://dash.cloudflare.com/?to=/:account/turnstile
